if (action === 'feed') {
                hunger += 20;
                energy -= 5;
                if(hunger > 100) hunger = 100;
                messageEl.textContent = "Ngon quá! Cảm ơn bạn đã cho mình ăn. 🍖";
            } else if (action === 'play') {
                if (energy < 15) {
                    messageEl.textContent = "Mệt quá... Mình không còn sức chơi nữa đâu! 🥱";
                    return;
                }
                happiness += 20;
                hunger -= 10;
                energy -= 15;
                if(happiness > 100) happiness = 100;
                messageEl.textContent = "Chơi đùa vui quá đi mất! ⚽";
            } else if (action === 'sleep') {
                energy += 30;
                hunger -= 5;
                if(energy > 100) energy = 100;
                messageEl.textContent = "Khò khò... Năng lượng đã được sạc đầy! 💤";
            }

            // Đảm bảo chỉ số không âm
            if(hunger < 0) hunger = 0;
            if(energy < 0) energy = 0;

            updateUI();
        }

